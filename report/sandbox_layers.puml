@startuml sandbox_layers
title Слои изоляции исполнения пользовательского кода

skinparam backgroundColor white
skinparam rectangle {
  FontSize 13
  BorderColor #333333
}
skinparam note {
  BackgroundColor #FFFDE7
  BorderColor #999999
}

rectangle "Хост-система\n(ОС исполнителя)" as host #ECEFF1 {
  rectangle "Процесс приложения (Rust)" as app #CFD8DC {
    rectangle "Встроенный CPython (PyO3)\nсамодостаточный дистрибутив + изолированный venv" as py #B0BEC5 {
      rectangle "smolagents LocalPythonExecutor\n(изолированный интерпретатор кода)" as sa #90A4AE {
        rectangle "Пользовательский\nPython-код задачи" as code #FFFFFF
      }
    }
  }
}

note right of sa
  Белый список импортов
  Блок небезопасных подмодулей
  (например random._os)
  Жёсткий лимит числа операций
  (прерывает бесконечные циклы)
  Лимит реального времени
  print --> буфер (не на консоль хоста)
end note

@enduml
