@startuml C4_Container_BOINC_Quota

!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

LAYOUT_WITH_LEGEND()

title C4 Container — boinc-quota-rs

Person(user, "Пользователь", "Запускает узел как координатор или воркер через GUI")

System_Boundary(node, "Узел boinc-quota-rs (один процесс Rust)") {

    Container(gui, "GUI (Desktop App)", "Rust / eframe 0.34", "Отображает состояние сети, проекты, задачи, блокчейн.\nПринимает команды пользователя через интерактивные панели.")

    Container(actor, "NetworkActor", "Rust / Tokio async", "Координирует сетевую логику и P2P-мэш.\nРелеит сообщения консенсуса между пирами с дедупликацией (seen-set).\nВ режиме координатора принимает TCP-соединения и тикает часы сети.")

    Container(network_engine, "Network Engine", "Rust (синхронный)", "Доменная модель: участники, проекты, задачи, аренда (lease).\nРепутационно-взвешенный консенсус по результатам задач.\nРаспределяет награды, применяет штрафы, ведёт очередь задач.")

    Container(consensus, "Consensus Engine", "Rust (BFT)", "Распределённый консенсус вставки блоков.\nProposer round-robin, голоса валидаторов, кворумный сертификат.\nРеплицированная цепочка на каждом узле.")

    Container(blockchain, "Blockchain", "Rust (in-process)", "Связанный список блоков с SHA-256.\nКаждый блок несёт BFT-сертификат (подписи валидаторов).\nФиксирует mint / transfer / burn, проверяет целостность цепочки.")

    Container(executor, "Executor", "Rust", "Берёт задачи из очереди и выполняет Python-payload.\nИзмеряет стоимость через Estimator.\nВозвращает digest и stdout для консенсуса.")

    Container(estimator, "Estimator", "Rust", "Предварительная оценка стоимости по исходнику.\nИзмеряет фактическую стоимость прогоном в песочнице.")

    Container(sandbox, "Python Sandbox", "Rust / PyO3", "Исполняет пользовательский Python во встроенном интерпретаторе (Python::attach / GIL).\nОграничивает доступные пакеты и время выполнения.")

    Container(pyenv, "PyEnv", "Rust + Python (PyO3 0.28)", "Встроенный python-build-standalone рядом с бинарём.\nВыставляет PYTHONHOME, ведёт writable venv (smolagents + разрешённые пакеты).")

    Container(identity, "Identity", "Rust / Ed25519 + X25519", "Генерирует или загружает ключевую пару.\nПодписывает nonce при handshake и блоки в консенсусе.\nШифрует stdout-результаты для владельца проекта.")

    ContainerDb(identity_file, "Ключевая пара", "Файл (~/.boinc-quota/identity.json)", "Персистентный Ed25519 + X25519 keypair узла.")

    ContainerDb(coord_state, "Состояние координатора", "Файл (<data_local_dir>/boinc-quota/coordinator-state.json)", "Сериализованное состояние Network (JSON).\nВосстанавливается при перезапуске.")

    ContainerDb(python_bundle, "Python-бандл + venv", "Каталоги (python/ рядом с бинарём, venv в data dir)", "Встроенный интерпретатор и установленные пакеты.")
}

System_Ext(remote_node, "Удалённый узел\n(Координатор или Воркер)", "Другой экземпляр boinc-quota-rs")

' User → GUI
Rel(user, gui, "Управляет", "клики / ввод")

' GUI ↔ NetworkActor
Rel(gui, actor, "AppCommand", "mpsc channel")
Rel(actor, gui, "AppEvent / StateUpdate", "mpsc channel")

' NetworkActor → Network Engine
Rel(actor, network_engine, "register / create / submit / tick / task-consensus", "вызов методов")

' Network Engine → Blockchain (режим координатора)
Rel(network_engine, blockchain, "commit_block (mint / transfer / burn)", "вызов методов")

' NetworkActor → Consensus Engine (распределённый режим)
Rel(actor, consensus, "submit_local_tx / on_message / try_propose", "вызов методов")

' Consensus Engine → Blockchain
Rel(consensus, blockchain, "append (блок с BFT-сертификатом)", "вызов методов")

' NetworkActor → Executor
Rel(actor, executor, "process_next_task", "spawn_blocking / tokio::spawn")

' Executor → Network Engine
Rel(executor, network_engine, "request_task / heartbeat / submit_result", "вызов методов")

' Executor → Estimator
Rel(executor, estimator, "pre_estimate / measure_via_sandbox", "вызов методов")

' Estimator → Sandbox
Rel(estimator, sandbox, "run_python_sandboxed", "вызов методов")

' Sandbox → PyEnv
Rel(sandbox, pyenv, "venv interpreter / site-packages", "PyO3 + fs")

' Executor → Identity (шифрование результата)
Rel(executor, identity, "encrypt_for (pubkey)", "вызов методов")

' Identity → файл
Rel(identity, identity_file, "load / save", "fs I/O")

' Consensus / Actor → Identity (подпись блоков, handshake)
Rel(actor, identity, "load_or_generate / sign_nonce / sign_block", "вызов методов")

' NetworkActor → coord_state (персистентность)
Rel(actor, coord_state, "persist / load", "serde_json + fs I/O")

' PyEnv → бандл
Rel(pyenv, python_bundle, "resolve / pip install", "fs I/O")

' NetworkActor ↔ Remote node (P2P-мэш)
Rel(actor, remote_node, "P2pMessage: PeerRequest / ConsensusMsg (JSON lines)", "TCP")
Rel(remote_node, actor, "P2pMessage: PeerResponse / ConsensusMsg / StateUpdate", "TCP")

@enduml
